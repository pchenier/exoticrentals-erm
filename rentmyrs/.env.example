# Base Postgres partagée avec exoticrentalsmontreal.com :
# demandes de réservation (booking_requests) et réglages de l'admin (rentmyrs_fleet).
POSTGRES_URL=

# Mot de passe de /admin (aucun mot de passe dans le code).
ADMIN_PASSWORD=

# Vercel Blob : téléversement des photos depuis /admin.
BLOB_READ_WRITE_TOKEN=

# Notifications push (optionnel : sinon les clés sont générées et gardées dans la base)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
